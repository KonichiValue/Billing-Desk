<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.tg-billing-desk.post</string>

    <!-- Build the post-standup action list and open it in the browser. -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>/Users/rei.samuelsson/Projects/tg-billing-desk/run_post.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/rei.samuelsson/Projects/tg-billing-desk</string>

    <!-- Mon (1), Wed (3), Thu (4) at 11:00 local time, just as the standup ends.
         The Notion meeting note lands about five minutes later, and the meeting
         sometimes overruns, so run_post.sh polls every five minutes until 11:45
         and gives up after that. It will not rebuild a page it already built
         today. -->
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>11</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>11</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>11</integer><key>Minute</key><integer>0</integer></dict>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/rei.samuelsson/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>TZ</key>
        <string>Asia/Tokyo</string>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/rei.samuelsson/Projects/tg-billing-desk/logs/launchd-post.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/rei.samuelsson/Projects/tg-billing-desk/logs/launchd-post.err.log</string>
</dict>
</plist>
