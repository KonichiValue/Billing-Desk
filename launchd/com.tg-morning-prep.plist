<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.tg-morning-prep</string>

    <!-- Build the TG billing standup prep page and open it in the browser. -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>/Users/rei.samuelsson/Projects/tg-morning-prep/run_prep.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/rei.samuelsson/Projects/tg-morning-prep</string>

    <!-- Mon (1), Wed (3), Thu (4) at 09:10 local time. If the Mac is asleep or
         off at 09:10, launchd fires the job as soon as it wakes, which is the
         "whenever I open the laptop" behaviour. run_prep.sh will not rebuild a
         page it already built today. -->
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>9</integer><key>Minute</key><integer>10</integer></dict>
        <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>9</integer><key>Minute</key><integer>10</integer></dict>
        <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>9</integer><key>Minute</key><integer>10</integer></dict>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/rei.samuelsson/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>TZ</key>
        <string>Asia/Tokyo</string>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/rei.samuelsson/Projects/tg-morning-prep/logs/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/rei.samuelsson/Projects/tg-morning-prep/logs/launchd.err.log</string>
</dict>
</plist>
