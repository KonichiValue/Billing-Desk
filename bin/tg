#!/bin/zsh
# One command for the TG billing work, from the terminal or the Dock.
#
#   tg                  open the desk, print where everything sits
#   tg s                print status only, costs nothing
#   tg 4                item 4 is finished
#   tg 2 -w Kevin       sent, now sitting with Kevin
#   tg 2 --mine         he replied, it is yours again
#   tg 5 --dropped -n "TG answered it themselves"
#   tg refresh          sweep every open ticket and thread, rebuild, open
#   tg prep             sweep, then write today's standup script
#   tg chat             open the folder in Cursor to hand work over
#   tg build            rebuild the page from the board, no agent
#   tg post             fold today's Notion meeting note into the board
#   tg phone [mins]     open this page to the wifi for an hour, for a phone
#   tg stop             shut the local page server down
#
# Anything numeric goes straight to tick.py, so the numbers you see on the page
# are the numbers you type. They belong to the item until it closes.

set -uo pipefail

REPO="${TG_STANDUP_REPO:-$HOME/Projects/tg-billing-desk}"
cd "$REPO" || { print -u2 "no repo at $REPO"; exit 1 }

export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"
export TZ="Asia/Tokyo"

BOARD="state/board.json"
# Global, because the EXIT trap that clears it fires after the function that
# takes it has returned and its locals have gone.
LOCK="state/refresh.lock"

PORT="${TG_DESK_PORT:-8787}"
CHROME="/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"

serve_url() {
  # The server renders the page on every load and gives the Refresh button
  # somewhere to send its click. Start it once, reuse it after that.
  local health
  health="$(curl -fsS --max-time 2 "http://127.0.0.1:$PORT/health" 2>/dev/null)" || {
    mkdir -p logs
    nohup python3 serve.py --port "$PORT" >>logs/serve.log 2>&1 &
    for _ in {1..25}; do
      sleep 0.2
      health="$(curl -fsS --max-time 2 "http://127.0.0.1:$PORT/health" 2>/dev/null)" && break
    done
  }
  [[ -n "$health" ]] || return 1
  local key="${${health##*\"key\": \"}%%\"*}"
  print -r -- "http://127.0.0.1:$PORT/?k=$key"
}

page() {
  [[ -f "$BOARD" ]] || { print -u2 "no board yet, run: tg build"; return 1 }

  local url
  if url="$(serve_url)"; then
    # Its own window, no tabs and no address bar, like a real app.
    if [[ -x "$CHROME" ]]; then
      "$CHROME" --app="$url" --window-size=1180,900 >/dev/null 2>&1 &
      return 0
    fi
    open "$url"
    return 0
  fi

  print -u2 "desk server would not start, opening the file instead"
  python3 render_desk.py "$BOARD" output/desk.html >/dev/null || return 1
  python3 render_desk_md.py "$BOARD" output/desk.md >/dev/null
  open output/desk.html
}

phone_url() {
  # The same page, over the wifi, so it is readable on a phone. Nothing is
  # published: it is this laptop answering, the key still has to be right, and
  # the window shuts by itself so an open port is never something to remember.
  local url ip mins="${2:-60}"
  url="$(serve_url)" || { print -u2 "desk server would not start"; return 1 }
  ip="$(ipconfig getifaddr en0 2>/dev/null || ipconfig getifaddr en1 2>/dev/null)"
  [[ -n "$ip" ]] || { print -u2 "not on a network"; return 1 }
  pkill -f "serve.py --port $PORT" >/dev/null 2>&1
  mkdir -p logs
  nohup python3 serve.py --port "$PORT" --lan "$mins" >>logs/serve.log 2>&1 &
  sleep 1
  url="$(serve_url)" || return 1
  print -r -- "On the same wifi, open: ${url/127.0.0.1/$ip}"
  print -r -- "Open for $mins min, then it goes back to this laptop only."
  print -r -- "Only reachable from this wifi, and only while the laptop is awake."
}

stop_server() {
  pkill -f "serve.py --port $PORT" && print -r -- "stopped the desk server" \
    || print -r -- "no desk server running"
}

run_agent() {
  # $1 is the prompt file, $2 is what to print while it works.
  if ! command -v cursor-agent >/dev/null 2>&1; then
    print -u2 "cursor-agent is not installed. Type 'refresh' in a Cursor chat on this folder instead."
    return 1
  fi
  # One agent at a time. Two of them writing the board is how it ends up half
  # updated, and the buttons on the page take the same lock.
  if [[ -f "$LOCK" ]] && kill -0 "$(cut -d' ' -f1 "$LOCK")" 2>/dev/null; then
    print -u2 "already running ($(cat "$LOCK"))"
    return 1
  fi
  mkdir -p state
  print -r -- "$$ terminal $(date +%H:%M)" >"$LOCK"
  trap 'rm -f "$LOCK"' EXIT INT TERM
  print -r -- "$2"
  cursor-agent --print --force --approve-mcps --trust \
    --workspace "$REPO" ${TG_MODEL:+--model "$TG_MODEL"} \
    "$(cat "$1")"
}

case "${1:-}" in
  "")            python3 tick.py; page ;;
  s|st|status)   python3 tick.py ;;
  refresh|r)
    run_agent prompt-refresh.md "Looking for what moved since the page was built..." || exit 1
    page ;;
  prep|p)
    run_agent prompt-prep.md "Sweeping everything, then writing today's script..." || exit 1
    page ;;
  chat)          open -a Cursor "$REPO" ;;
  phone)         phone_url "$@" ;;
  stop)          stop_server ;;
  build)
    python3 render_desk.py "$BOARD" output/desk.html || exit 1
    python3 render_desk_md.py "$BOARD" output/desk.md ;;
  post)          ./run_post.sh --force ;;
  open)          page ;;
  -h|--help|help) sed -n '2,19p' "$0" | sed 's/^# \{0,1\}//' ;;
  *)             python3 tick.py "$@" ;;
esac
